<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow static assets (images, CSS, JS, fonts, etc.) to be served directly
  RewriteCond %{REQUEST_URI} \.(avif|jpg|jpeg|png|gif|svg|ico|webp|css|js|json|woff|woff2|ttf|eot|map)$ [NC]
  RewriteRule ^ - [L]
  
  # Allow _next directory (Next.js assets) to be served directly
  RewriteCond %{REQUEST_URI} ^/_next/ [NC]
  RewriteRule ^ - [L]
  
  # Allow api directory to be served directly
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]
  
  # If the requested resource is not a file or directory, serve index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>